# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# URL base de TheMealDB (sin la clave al final)
MEALDB_API_URL=https://www.themealdb.com/api/json/v1

# Clave de TheMealDB. "1" es la clave pública de desarrollo/educación.
# Si tienes una clave Premium de Patreon, colócala aquí.
# Solo se lee en el servidor (no lleva el prefijo NEXT_PUBLIC_).
MEALDB_API_KEY=1

# URL pública del sitio (para metadatos y enlaces compartidos).
# En local: http://localhost:3000 — en Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
